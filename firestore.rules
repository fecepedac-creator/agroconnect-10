rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ======================
       Helpers básicos
       ====================== */

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myUser() {
      return userDoc(myUid());
    }

    function myRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && myUser().data.role != null
          ? myUser().data.role
          : "none";
    }

    /* ======================
       SUPER ADMIN
       ====================== */

    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.get("admin", false) == true
          || request.auth.token.get("superadmin", false) == true
          || request.auth.token.get("role", "") == "ADMIN"
          || request.auth.token.get("role", "") == "admin"
          || request.auth.token.get("role", "") == "SUPERADMIN"
          || request.auth.token.get("role", "") == "superadmin"
        );
    }

    function isWorker() {
      return signedIn() && myRole() == "worker";
    }

    function myCompanyId() {
      return signedIn() && myUser().data.companyId != null
        ? myUser().data.companyId
        : null;
    }

    function userUpdateKeepsRoleAndCompany() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('companyId', null) == resource.data.get('companyId', null)
        && request.resource.data.get('rut', null) == resource.data.get('rut', null);
    }

    function hasActiveCompanyMembership(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/company_members/$(myUid()))
        && get(/databases/$(database)/documents/companies/$(companyId)/company_members/$(myUid())).data.get('status', '') == 'active'
        && get(/databases/$(database)/documents/companies/$(companyId)/company_members/$(myUid())).data.get('role', '') in ['company_admin', 'company_hr'];
    }

    function isActiveCompany(companyId) {
      return companyId != null
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.get('status', '') == 'active';
    }

    function isMyCompany(companyId) {
      return isActiveCompany(companyId) && hasActiveCompanyMembership(companyId);
    }

    function canManageCompanyMembers(companyId) {
      return isSuperAdmin()
        || (
          isMyCompany(companyId)
          && get(/databases/$(database)/documents/companies/$(companyId)/company_members/$(myUid())).data.get('role', '') == 'company_admin'
        );
    }

    function companyCanPublish(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.get('status', '') == 'active';
    }

    function jobIsPublished(data) {
      return data.get('isActive', false) == true
        || data.get('jobStatus', '') == 'active';
    }

    function publishedJobIsComplete(data) {
      return data.get('title', '') is string
        && data.get('title', '').size() >= 3
        && data.get('title', '').size() <= 200
        && data.get('location', '') is string
        && data.get('location', '').size() >= 2
        && data.get('location', '').size() <= 200
        && data.get('workersNeeded', 0) is number
        && data.get('workersNeeded', 0) > 0
        && data.get('workersNeeded', 0) <= 500
        && data.get('publishPublic', false) == true;
    }

    function companyJobWriteIsAllowed(companyId) {
      return !jobIsPublished(request.resource.data)
        || (companyCanPublish(companyId) && publishedJobIsComplete(request.resource.data));
    }

    function applicationCreateIsValid(companyId, jobId, workerId) {
      return request.resource.data.keys().hasAll([
          'workerId', 'companyId', 'jobId', 'jobTitle', 'companyName',
          'appliedAt', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'workerId', 'companyId', 'jobId', 'jobTitle', 'companyName',
          'appliedAt', 'createdAt', 'status'
        ])
        && request.resource.data.workerId == workerId
        && request.resource.data.companyId == companyId
        && request.resource.data.jobId == jobId
        && request.resource.data.status == 'postulado'
        && request.resource.data.jobTitle is string
        && request.resource.data.jobTitle.size() > 0
        && request.resource.data.jobTitle.size() <= 200
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() <= 200
        && request.resource.data.appliedAt == request.time
        && request.resource.data.createdAt == request.time
        && isActiveCompany(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId)/jobs/$(jobId))
        && jobIsPublished(get(/databases/$(database)/documents/companies/$(companyId)/jobs/$(jobId)).data)
        && publishedJobIsComplete(get(/databases/$(database)/documents/companies/$(companyId)/jobs/$(jobId)).data);
    }

    function companyApplicationCreateIsValid(companyId, jobId, workerId, appId) {
      return appId == workerId
        && applicationCreateIsValid(companyId, jobId, workerId);
    }

    function workerApplicationCreateIsValid(companyId, jobId, workerId, appId) {
      return appId == companyId + '_' + jobId
        && applicationCreateIsValid(companyId, jobId, workerId);
    }

    /* ======================
       Helpers PUBLIC
       ====================== */

    function isPublicDoc() {
      return resource != null 
        && ((resource.data.isPublic == true) || (resource.data.public == true));
    }

    /* ======================
       Seguridad updates empresa
       ====================== */

    function companyUpdateKeepsCriticalFields() {
      return request.resource.data.get('adminEmail', null) == resource.data.get('adminEmail', null)
        && request.resource.data.get('rut', null) == resource.data.get('rut', null)
        && request.resource.data.get('subscriptionPlan', null) == resource.data.get('subscriptionPlan', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null);
    }

    function workerApplicationUpdateIsSafe() {
      return request.resource.data.get('workerId', null) == resource.data.get('workerId', null)
        && request.resource.data.get('companyId', null) == resource.data.get('companyId', null)
        && request.resource.data.get('jobId', null) == resource.data.get('jobId', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('attendanceStatus', null) == resource.data.get('attendanceStatus', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('decisionBy', null) == resource.data.get('decisionBy', null)
        && request.resource.data.get('decisionAt', null) == resource.data.get('decisionAt', null);
    }

    /* ======================
       USERS
       ====================== */

    match /users/{uid} {
      allow read: if signedIn() && uid == myUid();
      allow create: if signedIn()
        && uid == myUid()
        && request.resource.data.role == "worker"
        && !('rut' in request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow update: if signedIn()
        && uid == myUid()
        && userUpdateKeepsRoleAndCompany();
      allow delete: if isSuperAdmin();

    }

    /* ======================
       PUBLIC
       ====================== */

    match /publicCompanies/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /publicJobs/{publicJobId} {
      allow read: if true;
      allow write: if false;  // Only Cloud Functions via Admin SDK
    }

    match /publicWorkers/{workerId} {
      allow read: if isSuperAdmin()
                  || (signedIn() && workerId == myUid());
      allow write: if isSuperAdmin();
    }

    match /discoverableWorkers/{workerId} {
      allow read: if isSuperAdmin()
        || isMyCompany(myCompanyId())
        || (signedIn() && workerId == myUid());
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if isSuperAdmin()
        || (isWorker() && resource.data.workerId == myUid())
        || isMyCompany(resource.data.companyId);
      allow write: if false;
    }

    match /match_reviews/{reviewId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.authorUid == myUid())
        || (
          isMyCompany(resource.data.companyId)
          && (
            resource.data.side == 'company_to_worker'
            || resource.data.visible == true
          )
        )
        || (
          resource.data.visible == true
          && isWorker()
          && resource.data.workerId == myUid()
        );
      allow write: if false;
    }

    match /worker_credentials/{credentialId} {
      allow read: if isSuperAdmin()
        || (isWorker() && resource.data.workerId == myUid())
        || (
          isMyCompany(myCompanyId())
          && resource.data.status == 'active'
          && resource.data.visibility == 'public'
        );
      allow write: if false;
    }

    match /worker_reputation/{workerId} {
      allow read: if isSuperAdmin()
        || isMyCompany(myCompanyId())
        || (isWorker() && workerId == myUid());
      allow write: if false;
    }

    match /company_reputation/{companyId} {
      allow read: if isSuperAdmin()
        || isWorker()
        || isMyCompany(companyId);
      allow write: if false;
    }

    /* ======================
       LEADS (public)
       ====================== */

    match /company_leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll([
                      'companyName', 'rut', 'email', 'status', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'companyName', 'rut', 'email', 'phone', 'region', 'notes',
                      'status', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() >= 2
                    && request.resource.data.companyName.size() <= 160
                    && request.resource.data.rut is string
                    && request.resource.data.rut.size() >= 7
                    && request.resource.data.rut.size() <= 20
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.status == "pending"
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
                    && (!('region' in request.resource.data) || (request.resource.data.region is string && request.resource.data.region.size() <= 100))
                    && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow read, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /audits/{auditId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_audit/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;  // Only Cloud Functions via Admin SDK
    }

    match /data_deletion_requests/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && uid == myUid());
      allow write: if false;  // Only Cloud Functions via Admin SDK
    }

    match /safety_reports/{reportId} {
      allow read: if isSuperAdmin();
      allow write: if false;  // Only Cloud Functions via Admin SDK
    }

    match /privacy_audit/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /* ======================
       WORKERS
       ====================== */

    match /workers/{uid} {
      allow read: if signedIn() && uid == myUid();
      allow create: if signedIn()
        && uid == myUid()
        && request.resource.data.role == "worker"
        && !('rut' in request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow update: if signedIn()
        && uid == myUid()
        && userUpdateKeepsRoleAndCompany();
      allow delete: if isSuperAdmin();

      match /applications/{appId} {
        allow read: if signedIn() && uid == myUid();
        allow create: if signedIn()
          && uid == myUid()
          && workerApplicationCreateIsValid(
            request.resource.data.companyId,
            request.resource.data.jobId,
            uid,
            appId
          );
        allow update: if signedIn()
          && uid == myUid()
          && workerApplicationUpdateIsSafe();
        allow delete: if false;
      }

      match /documents/{docId} {
        allow read, write: if signedIn() && uid == myUid();
      }
    }

    match /worker_usernames/{rut} {
      allow read: if signedIn() && resource.data.uid == myUid();
      allow write: if false;
    }

    /* ======================
       COMPANIES
       ====================== */

    match /companies/{companyId} {

      allow read: if isSuperAdmin()
                  || isMyCompany(companyId);
      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (isMyCompany(companyId) && companyUpdateKeepsCriticalFields());

      allow delete: if isSuperAdmin();

      match /company_members/{memberUid} {
        allow read: if isSuperAdmin()
          || (signedIn() && memberUid == myUid())
          || canManageCompanyMembers(companyId);
        allow write: if false;
      }

      match /contact_grants/{grantId} {
        allow read: if (
          isSuperAdmin()
          || isMyCompany(companyId)
          || (isWorker() && resource.data.workerId == myUid())
        )
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time;
        allow write: if false;
      }

      /* ----- JOBS ----- */
      match /jobs/{jobId} {

        allow read: if isSuperAdmin()
                    || isMyCompany(companyId)
                    || (isWorker()
                        && resource.data.get('isActive', false) == true
                        && resource.data.get('publishPublic', false) == true);

        allow create, update: if isSuperAdmin()
                             || (isMyCompany(companyId) && companyJobWriteIsAllowed(companyId));
        allow delete: if isSuperAdmin() || isMyCompany(companyId);

        /* ----- APPLICATIONS ----- */
        match /applications/{appId} {

          allow read: if isSuperAdmin()
                      || isMyCompany(companyId)
                      || (isWorker()
                          && request.auth.uid == resource.data.workerId);

          allow create: if isWorker()
                        && companyApplicationCreateIsValid(companyId, jobId, myUid(), appId);

          allow update: if isSuperAdmin()
                        || isMyCompany(companyId)
                        || (isWorker()
                            && request.auth.uid == resource.data.workerId
                            && workerApplicationUpdateIsSafe());

          allow delete: if isSuperAdmin();
        }

        /* ----- ATTENDANCE ----- */
        match /attendance/{shiftId} {

          allow read: if isSuperAdmin()
                      || isMyCompany(companyId);
          // Workers can only read their own entries via the nested entries rule

          match /entries/{workerId} {

            allow read: if isSuperAdmin()
                        || isMyCompany(companyId)
                        || (isWorker() && workerId == myUid());

            allow create, update: if isSuperAdmin()
                                  || isMyCompany(companyId)
                                  || (isWorker() && workerId == myUid());

            allow delete: if isSuperAdmin();
          }
        }

        /* ----- POSTERS ----- */
        match /posters/{posterId} {
          allow read, write: if isSuperAdmin() || isMyCompany(companyId);
          allow delete: if isSuperAdmin() || isMyCompany(companyId);
        }
      }

      /* ----- BILLING ----- */
      match /billing/{documentId} {
        allow read: if isSuperAdmin() || isMyCompany(companyId);
        allow write: if false;
      }

      match /billing_payments/{paymentId} {
        allow read: if isSuperAdmin() || isMyCompany(companyId);
        allow write: if false;
      }

      match /billing_invoices/{invoiceId} {
        allow read: if isSuperAdmin() || isMyCompany(companyId);
        allow write: if false;
      }

      /* ----- BROADCASTS ----- */
      match /broadcasts/{broadcastId} {
        allow read, write: if isSuperAdmin() || isMyCompany(companyId);
        allow delete: if isSuperAdmin();
      }
    }

    /* ======================
       STATS / FINOPS
       ====================== */

    match /stats/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /stats_monthly/{ym} {
      allow read, write: if isSuperAdmin();
    }

    match /stats_companies/{companyId} {
      allow read: if isSuperAdmin() || isMyCompany(companyId);
      allow write: if isSuperAdmin();

      match /monthly/{ym} {
        allow read: if isSuperAdmin() || isMyCompany(companyId);
        allow write: if isSuperAdmin();
      }
    }

    match /finops_infra/{ym} {
      allow read, write: if isSuperAdmin();
    }

    match /finops_manualExpenses/{expenseId} {
      allow read, write: if isSuperAdmin();
    }

    /* ======================
       MENSAJERÍA / EMAIL
       ====================== */

    // Cola de mensajes (UI ? Function / Trigger Email)
    match /comms_outbox/{docId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin()
        || isMyCompany(resource.data.get('companyId', null));
      allow update, delete: if false;
    }

    // Colección mail (si usas Firebase Trigger Email)
    match /mail/{mailId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }



    /* ======================
       PREADMISSIONS
       ====================== */

    // Colección global legacy: bloqueada por seguridad (evitar spam/contaminación)
    match /preadmissions/{docId} {
      allow read, write: if false;
    }

    // Flujo público vigente por centro
    match /centers/{centerId}/preadmissions/{docId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly([
          'centerId', 'companyId', 'name', 'fullName', 'email', 'phone', 'rut',
          'reason', 'motive', 'observation', 'observations', 'notes', 'status',
          'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && (!('centerId' in request.resource.data) || request.resource.data.centerId == centerId)
        && (!('companyId' in request.resource.data) || request.resource.data.companyId == centerId)
        && (('name' in request.resource.data) || ('fullName' in request.resource.data))
        && (
          ('email' in request.resource.data && request.resource.data.email is string && request.resource.data.email.size() >= 5)
          || ('phone' in request.resource.data && request.resource.data.phone is string && request.resource.data.phone.size() >= 7)
        )
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200))
        && (!('fullName' in request.resource.data) || (request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2 && request.resource.data.fullName.size() <= 200))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 50))
        && (!('rut' in request.resource.data) || (request.resource.data.rut is string && request.resource.data.rut.size() <= 30))
        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500))
        && (!('motive' in request.resource.data) || (request.resource.data.motive is string && request.resource.data.motive.size() <= 500))
        && (!('observation' in request.resource.data) || (request.resource.data.observation is string && request.resource.data.observation.size() <= 500))
        && (!('observations' in request.resource.data) || (request.resource.data.observations is string && request.resource.data.observations.size() <= 500))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));

      allow read, delete: if isSuperAdmin()
        || isMyCompany(centerId);

      allow update: if isSuperAdmin()
        || (
          isMyCompany(centerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'notes', 'observation', 'observations', 'updatedAt'
          ])
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'contacted', 'approved', 'rejected'])
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
          && (!('observation' in request.resource.data) || (request.resource.data.observation is string && request.resource.data.observation.size() <= 500))
          && (!('observations' in request.resource.data) || (request.resource.data.observations is string && request.resource.data.observations.size() <= 500))
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
        );
    }

    /* ======================
       DEFAULT DENY
       ====================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}


