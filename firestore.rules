rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ======================
       Helpers básicos
       ====================== */

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myUser() {
      return userDoc(myUid());
    }

    function myRole() {
      return signedIn()
        && myUser().exists
        && myUser().data.role != null
          ? myUser().data.role
          : "none";
    }

    /* ======================
       SUPER ADMIN
       ====================== */

    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.superadmin == true
          || request.auth.token.role == "ADMIN"
          || request.auth.token.role == "admin"
          || request.auth.token.role == "SUPERADMIN"
          || request.auth.token.role == "superadmin"
          || myRole() == "superadmin"
        );
    }

    function isWorker() {
      return signedIn() && myRole() == "worker";
    }

    function isCompany() {
      return signedIn()
        && (myRole() == "company_admin" || myRole() == "company_hr");
    }

    function myCompanyId() {
      return signedIn() && myUser().data.companyId != null
        ? myUser().data.companyId
        : null;
    }

    function isMyCompany(companyId) {
      return isCompany() && myCompanyId() == companyId;
    }

    /* ======================
       Helpers PUBLIC
       ====================== */

    function isPublicDoc() {
      return (resource.data.isPublic == true) || (resource.data.public == true);
    }

    /* ======================
       Seguridad updates empresa
       ====================== */

    function companyUpdateKeepsCriticalFields() {
      return request.resource.data.adminEmail == resource.data.adminEmail
        && request.resource.data.rut == resource.data.rut
        && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
        && request.resource.data.status == resource.data.status;
    }

    /* ======================
       USERS
       ====================== */

    match /users/{uid} {
      allow read: if signedIn() && uid == myUid();
      allow create: if signedIn()
        && uid == myUid()
        && request.resource.data.role == "worker"
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow update: if signedIn() && uid == myUid();
      allow delete: if isSuperAdmin();
    }

    /* ======================
       PUBLIC
       ====================== */

    match /publicCompanies/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /publicJobs/{publicJobId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /publicWorkers/{workerId} {
      allow read: if isSuperAdmin()
                  || isCompany()
                  || (signedIn() && workerId == myUid());
      allow write: if isSuperAdmin();
    }

    /* ======================
       LEADS (public)
       ====================== */

    match /company_leads/{leadId} {
      allow create: if request.resource.data.companyName is string
                    && request.resource.data.rut is string
                    && request.resource.data.email is string
                    && request.resource.data.status == "pending";
      allow read, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /audits/{auditId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin/{docId} {
      allow read, write: if isSuperAdmin();
    }

    /* ======================
       WORKERS
       ====================== */

    match /workers/{uid} {
      allow read: if signedIn() && uid == myUid();
      allow create: if signedIn()
        && uid == myUid()
        && request.resource.data.role == "worker"
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow update: if signedIn() && uid == myUid();
      allow delete: if false;

      match /applications/{appId} {
        allow read, write: if signedIn() && uid == myUid();
      }

      match /documents/{docId} {
        allow read, write: if signedIn() && uid == myUid();
      }
    }

    match /worker_usernames/{rut} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == myUid()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if false;
    }

    /* ======================
       COMPANIES
       ====================== */

    match /companies/{companyId} {

      allow read: if isSuperAdmin()
                  || isMyCompany(companyId)
                  || isPublicDoc();
      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (isMyCompany(companyId) && companyUpdateKeepsCriticalFields());

      allow delete: if isSuperAdmin();

      /* ----- JOBS ----- */
      match /jobs/{jobId} {

        allow read: if isSuperAdmin()
                    || isMyCompany(companyId)
                    || isWorker();

        allow create, update: if isSuperAdmin() || isMyCompany(companyId);
        allow delete: if isSuperAdmin() || isMyCompany(companyId);

        /* ----- APPLICATIONS ----- */
        match /applications/{appId} {

          allow read: if isSuperAdmin()
                      || isMyCompany(companyId)
                      || (isWorker()
                          && request.auth.uid == resource.data.workerId);

          allow create: if isWorker()
                        && request.resource.data.workerId == myUid();

          allow update: if isSuperAdmin()
                        || isMyCompany(companyId)
                        || (isWorker()
                            && request.auth.uid == resource.data.workerId);

          allow delete: if isSuperAdmin();
        }

        /* ----- ATTENDANCE ----- */
        match /attendance/{shiftId} {

          allow read: if isSuperAdmin()
                      || isMyCompany(companyId)
                      || isWorker();

          match /entries/{workerId} {

            allow read: if isSuperAdmin()
                        || isMyCompany(companyId)
                        || (isWorker() && workerId == myUid());

            allow create, update: if isSuperAdmin()
                                  || isMyCompany(companyId)
                                  || (isWorker() && workerId == myUid());

            allow delete: if isSuperAdmin();
          }
        }

        /* ----- POSTERS ----- */
        match /posters/{posterId} {
          allow read, write: if isSuperAdmin() || isMyCompany(companyId);
          allow delete: if isSuperAdmin() || isMyCompany(companyId);
        }
      }

      /* ----- BILLING ----- */
      match /billing_payments/{paymentId} {
        allow read, write: if isSuperAdmin() || isMyCompany(companyId);
        allow delete: if isSuperAdmin();
      }

      match /billing_invoices/{invoiceId} {
        allow read, write: if isSuperAdmin() || isMyCompany(companyId);
        allow delete: if isSuperAdmin();
      }

      /* ----- BROADCASTS ----- */
      match /broadcasts/{broadcastId} {
        allow read, write: if isSuperAdmin() || isMyCompany(companyId);
        allow delete: if isSuperAdmin();
      }
    }

    /* ======================
       STATS / FINOPS
       ====================== */

    match /stats/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /stats_monthly/{ym} {
      allow read, write: if isSuperAdmin();
    }

    match /stats_companies/{companyId} {
      allow read: if isSuperAdmin() || isMyCompany(companyId);
      allow write: if isSuperAdmin();

      match /monthly/{ym} {
        allow read: if isSuperAdmin() || isMyCompany(companyId);
        allow write: if isSuperAdmin();
      }
    }

    match /finops_infra/{ym} {
      allow read, write: if isSuperAdmin();
    }

    match /finops_manualExpenses/{expenseId} {
      allow read, write: if isSuperAdmin();
    }

    /* ======================
       MENSAJERÍA / EMAIL
       ====================== */

    // Cola de mensajes (UI → Function / Trigger Email)
    match /comms_outbox/{docId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow update, delete: if false;
    }

    // Colección mail (si usas Firebase Trigger Email)
    match /mail/{mailId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /* ======================
       DEFAULT DENY
       ====================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
